{
  // Cloudflare Workers static-assets deploy for this site (no build step).
  // src/worker.js runs first to redirect http:// and www. to https://farsanaa.in.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digitalmarketingconsultantinkerala",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
